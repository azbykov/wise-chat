{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main",
    "seed": "nest build && node dist/seed/seed.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.3.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "^8.3.0",
    "mongoose": "9.11.4",
    "multer": "2.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "mongodb-memory-server": "11.3.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.34"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": "\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "globalSetup": "<rootDir>/test/setup/global-setup.ts",
    "globalTeardown": "<rootDir>/test/setup/global-teardown.ts",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup/per-file-env.ts"
    ],
    "testTimeout": 20000
  }
}
