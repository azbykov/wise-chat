# Local development: copy to .env (`cp .env.example .env`). Docker Compose does not need it.

# Backend
MONGO_URI=mongodb://127.0.0.1:27017/chat?directConnection=true
PORT=3000
CORS_ORIGIN=http://localhost:5173
# At least 32 characters; for anything but local development: openssl rand -base64 48
JWT_SECRET=local-demo-secret-change-me-please
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
COOKIE_SECURE=false
AUTH_RATE_LIMIT_PER_MINUTE=10
# Reverse proxies in front of the API (0 = none). Set it, or every client shares one rate limit.
TRUST_PROXY=0

# Frontend
PUBLIC_API_URL=http://localhost:3000

# Port of MongoDB on 127.0.0.1 for `pnpm db:up`
MONGO_PORT=27017
